[Unit]
Description=Trading Bot V3.3
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=trader
Group=trader
WorkingDirectory=/home/trader/apps/trading-bot
EnvironmentFile=/home/trader/apps/trading-bot/.env
ExecStart=/home/trader/apps/trading-bot/.venv/bin/python /home/trader/apps/trading-bot/main.py
Restart=always
RestartSec=10
TimeoutStopSec=30
StandardOutput=append:/home/trader/apps/trading-bot/logs/systemd-bot-out.log
StandardError=append:/home/trader/apps/trading-bot/logs/systemd-bot-err.log

[Install]
WantedBy=multi-user.target