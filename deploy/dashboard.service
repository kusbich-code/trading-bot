[Unit]
Description=Trading Bot Dashboard v4
After=network.target

[Service]
User=trader
Group=trader
WorkingDirectory=/home/trader/apps/trading-bot
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/trader/apps/trading-bot/.venv/bin/uvicorn app.webapp:app --host 0.0.0.0 --port 80
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
